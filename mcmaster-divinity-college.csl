<?xml version="1.0" encoding="utf-8"?>
<style class="note" version="1.0" and="text" initialize="false" initialize-with=". "
  page-range-format="minimal-two" demote-non-dropping-particle="sort-only" default-locale="en-US"
  xmlns="http://purl.org/net/xbiblio/csl">
  <!--
    McMaster Divinity College Press style.

    Implements the notes-and-bibliography citation system described in the
    McMaster Divinity College Press Style Guide (MDC), Version 1.2 (October 2025):
    https://mcmasterdivinity.ca/wp-content/uploads/2025/10/MDC-Press-Style-Guide-Version-1.2.pdf

    Section references in comments below (e.g. "MDC 1.2.1.2.4") point to numbered
    sections of that guide. Design notes worth knowing before editing:

    * Footnotes are always short-form (author short-name, short title, locator).
      MDC 1.1.2 explicitly forbids "ibid." and wants short titles even on a source's
      first appearance, so the citation layout has no position="first"/"ibid"
      branching. There is no separate "full first note" form to maintain.
    * Bibliography entries list every author/editor/translator; footnotes truncate
      to "et al." after 3+ names. This split (MDC's Version 1.2 update #4) is why
      several name macros come in two variants: a truncated one used only as a sort
      key, and an untruncated "full" one used for the actual bibliography text.    
    * The bibliography's sole/multi-authored-then-edited ordering (MDC 1.2.3)
      is implemented using APA 7th's convention for breaking ties
      among co-authored/co-edited works (by 2nd/3rd/... author).
    * Contrary to MDC Style, three em-dashes are used when a source has multiple
      authors or editors, because CSL cannot test for number of authors when substituting
      the dashes.
  -->
  <info>
    <title>McMaster Divinity College</title>
    <title-short>MDC</title-short>
    <id>https://www.zotero.org/styles/mcmaster-divinity-college</id>
    <link
      href="https://github.com/christopherland/zotero-mdc-style/blob/main/mcmaster-divinity-college.csl"
      rel="self"/>
    <link href="https://mcmasterdivinity.ca/mdcpress/#style-guide" rel="documentation"/>
    <author>
      <name>Dan Morrison</name>
      <email>morrid4@mcmaster.ca</email>
    </author>
    <author>
      <name>Christopher D. Land</name>
      <email>landc@mcmaster.ca</email>
    </author>
    <contributor>
      <name>Meghan D. Musy</name>
      <email>meghan.musy@gmail.com</email>
    </contributor>
    <contributor>
      <name>Alexander C. Stewart</name>
      <email>stewarac@mcmaster.ca</email>
    </contributor>
    <contributor>
      <name>Ryder Wishart</name>
      <email>wishartr@mcmaster.ca</email>
    </contributor>
    <contributor>
      <name>Ambrose Thomson</name>
      <email>ambrose.thomson@gmail.com</email>
    </contributor>
    <category citation-format="note"/>
    <category field="history"/>
    <summary>McMaster Divinity College style is used by students at MDC and authors publishing with
      MDC Press.</summary>
    <updated>2026-09-04T18:34:30+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a
      Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <!-- ==========================================================================
       NAMES: AUTHORS, EDITORS, TRANSLATORS, RECIPIENTS, INTERVIEWERS

       Building blocks first (editor/translator, in truncated, "-full", and
       "-note" short-form variants), then the composite "contributors-*"
       macros that assemble a full name list for one context each.
       ========================================================================== -->
  <!-- PRIMARY SORT KEY: author (or editor/translator if no author), truncated. Truncation here only
       affects the string used for alphabetizing, never what gets printed. For what gets output, see contributors-full/-short.
       et-al-min="1" (always truncate to the first name) is deliberate: it clusters all of a
       given first author's/editor's works together regardless of how many co-authors any one
       of them has, which the bibliography's sole-vs-multi ordering below depends on. -->
  <macro name="sort-contributors">
    <names variable="author">
      <name and="text" delimiter-precedes-et-al="after-inverted-name"
        delimiter-precedes-last="after-inverted-name" et-al-min="1" et-al-use-first="1"
        initialize="false" initialize-with=". " name-as-sort-order="first"/>
      <substitute>
        <text macro="sort-editors"/>
        <text macro="sort-translators"/>
      </substitute>
    </names>
  </macro>
  <macro name="sort-editors">
    <names variable="editor">
      <name and="text" delimiter-precedes-et-al="after-inverted-name"
        delimiter-precedes-last="always" et-al-min="3" et-al-use-first="1"
        name-as-sort-order="first"/>
      <label form="short" prefix=", "/>
    </names>
  </macro>
  <macro name="sort-translators">
    <names variable="translator">
      <name and="text" delimiter-precedes-et-al="after-inverted-name"
        delimiter-precedes-last="always" et-al-min="3" et-al-use-first="1"
        name-as-sort-order="first"/>
      <label form="short" prefix=", "/>
    </names>
  </macro>
  <!-- SECONDARY SORT KEY: the contributor-group key (1/2/3) makes the
       authored-vs-edited split explicit, since presence of "author" vs "editor" is
       something <choose><if> can test directly. -->
  <macro name="sort-contributor-group">
    <choose>
      <if variable="author">
        <text value="1"/>
      </if>
      <else-if variable="editor">
        <text value="2"/>
      </else-if>
      <else>
        <text value="3"/>
      </else>
    </choose>
  </macro>
  <!-- TERTIARY SORT KEY: The sole-vs-multi split needs no specific test. Instead, this
       sort-full-names key renders every name untruncated, so a solo work's sort string is
       always a strict prefix of any co-authored work sharing the same first name (compare
       "Smith, Jane" against "Smith, Jane and Zebra, Zed") and so always sorts first; ties
       among co-authored/co-edited works are then broken by the second author's surname,
       then the third, and so on - the same convention APA 7th uses (Publication Manual,
       7th ed., p. 305). -->
  <macro name="sort-full-names">
    <choose>
      <if variable="author">
        <names variable="author">
          <name and="text" name-as-sort-order="first" initialize="false" initialize-with=". "/>
        </names>
      </if>
      <else-if variable="editor">
        <names variable="editor">
          <name and="text" name-as-sort-order="first" initialize="false" initialize-with=". "/>
        </names>
      </else-if>
      <else-if variable="translator">
        <names variable="translator">
          <name and="text" name-as-sort-order="first" initialize="false" initialize-with=". "/>
        </names>
      </else-if>
    </choose>
  </macro>
  <!-- NAME OUTPUT MACROS -->
  <!-- In bibliographies, every author, editor, and translator gets listed, substituting editor-full/translator-full
       when there is no author (e.g. edited volumes). -->
  <macro name="contributors-full">
    <names variable="author">
      <name and="text" delimiter-precedes-et-al="after-inverted-name"
        delimiter-precedes-last="always" initialize="false" initialize-with=". "
        name-as-sort-order="first"/>
      <substitute>
        <text macro="editor-full"/>
        <text macro="translator-full"/>
      </substitute>
    </names>
  </macro>
  <macro name="editor-full">
    <names variable="editor">
      <name and="text" delimiter-precedes-et-al="after-inverted-name"
        delimiter-precedes-last="always" name-as-sort-order="first"/>
      <label form="short" prefix=", "/>
    </names>
  </macro>
  <macro name="translator-full">
    <names variable="translator">
      <name and="text" delimiter-precedes-et-al="after-inverted-name"
        delimiter-precedes-last="always" name-as-sort-order="first"/>
      <label form="short" prefix=", "/>
    </names>
  </macro>
  <!-- Footnotes use short-name + et-al after 3 (set on <citation>), substituting
       editor-note/translator-note, or recipient-short for personal_communication items. -->
  <macro name="contributors-short">
    <names variable="author">
      <name form="short" and="text" delimiter=", "/>
      <substitute>
        <text macro="editor-note"/>
        <text macro="translator-note"/>
      </substitute>
    </names>
    <text macro="recipient-short"/>
  </macro>
  <!-- Short-form editor substitute for footnotes, incl. the ", ed." label - MDC 1.2.1.1.7. -->
  <macro name="editor-note">
    <names variable="editor">
      <name form="short" and="text"/>
      <label form="short" prefix=", "/>
    </names>
  </macro>
  <!-- Short-form translator substitute for footnotes. -->
  <macro name="translator-note">
    <names variable="translator">
      <name form="short" and="text"/>
      <label form="verb-short" prefix=", "/>
    </names>
  </macro>
  <!-- Footnote "to Recipient" for personal_communication (letters, emails) - MDC 1.2.1.20. -->
  <macro name="recipient-short">
    <names variable="recipient">
      <label form="verb" prefix=" " suffix=" "/>
      <name form="short" and="text" delimiter=", "/>
    </names>
  </macro>
  <!-- Bibliography "Interview by X" credit line - MDC 1.2.1.20 Interviews. -->
  <macro name="interviewer">
    <names variable="interviewer" delimiter=", ">
      <label form="verb" prefix=" " text-case="capitalize-first" suffix=" "/>
      <name and="text" delimiter=", "/>
    </names>
  </macro>
  <!-- In a bibliography, secondary contributors follow the title when a higher-ranking contributor
    is primary (Author -> Editor -> Translator). For example, an authored book might need to include
    "Edited by X. Translated by Y." See MDC 1.2.1.1.4 Books with Editors, Translators, and/or Revisers. -->
  <macro name="editor-secondary">
    <choose>
      <if type="paper-conference entry-dictionary chapter entry-encyclopedia" match="none">
        <choose>
          <if variable="author">
            <names variable="editor">
              <label form="verb" text-case="capitalize-first" suffix=" "/>
              <name and="text" delimiter=", "/>
            </names>
          </if>
        </choose>
      </if>
    </choose>
  </macro>
  <macro name="translator-secondary">
    <choose>
      <if type="paper-conference entry-dictionary chapter entry-encyclopedia" match="none">
        <choose>
          <if variable="author editor" match="any">
            <names variable="translator">
              <label form="verb" text-case="capitalize-first" suffix=" "/>
              <name and="text" delimiter=","/>
            </names>
          </if>
        </choose>
      </if>
    </choose>
  </macro>
  <!-- The editor/translator credit for the CONTAINING work appears with its title when citing a chapter or an
       encyclopedia/dictionary entry - MDC 1.2.1.3 Book Chapters, 1.2.1.4 Encyclopedia Entries. -->
  <macro name="container-contributors">
    <choose>
      <if type="paper-conference entry-dictionary chapter entry-encyclopedia" match="any">
        <group delimiter=", ">
          <choose>
            <if variable="author">
              <names variable="container-author editor" delimiter=", ">
                <label form="verb" suffix=" "/>
                <name and="text" delimiter=", "/>
              </names>
            </if>
          </choose>
          <choose>
            <if variable="author editor" match="any">
              <names variable="translator" delimiter=", ">
                <label form="verb" suffix=" "/>
                <name and="text" delimiter=", "/>
              </names>
            </if>
          </choose>
        </group>
      </if>
    </choose>
  </macro>
  <!-- ==========================================================================
       TITLES AND CONTAINER TITLES
       ========================================================================== -->
  <!-- Bibliography title: italic for standalone works (books, films, etc.), quoted for
       articles/chapters, with the "Review of ..." handling for MDC 1.2.1.10 Book Reviews.
       Capitalization follows MDC 1.2.3.1 (headline-style title case). -->
  <macro name="title">
    <choose>
      <if variable="title" match="none">
        <choose>
          <if type="personal_communication" match="none">
            <text variable="genre"/>
          </if>
        </choose>
      </if>
      <else-if type="bill book graphic legal_case legislation motion_picture report">
        <group font-style="italic">
          <text variable="title" text-case="title"/>
        </group>
      </else-if>
      <else-if variable="reviewed-author">
        <group delimiter=", ">
          <text variable="title" font-style="italic" prefix="Review of "/>
          <names variable="reviewed-author">
            <label form="verb-short" text-case="lowercase" suffix=" "/>
            <name and="text" delimiter=", "/>
          </names>
        </group>
      </else-if>
      <else>
        <text variable="title" text-case="title" quotes="true"/>
      </else>
    </choose>
  </macro>
  <!-- Footnote short title - MDC 1.1.1 Short Titles. Relies on Zotero's "Short Title" field. -->
  <macro name="title-short">
    <choose>
      <if variable="title" match="none">
        <choose>
          <if type="interview">
            <text term="interview" text-case="lowercase"/>
          </if>
          <else-if type="manuscript speech">
            <text variable="genre" form="short"/>
          </else-if>
          <else-if type="personal_communication">
            <text macro="date-of-issue"/>
          </else-if>
        </choose>
      </if>
      <else-if type="bill book graphic legal_case legislation motion_picture report song">
        <text variable="title" form="short" text-case="title" font-style="italic"/>
      </else-if>
      <else-if variable="reviewed-author">
        <text variable="title-short" text-case="title" font-style="italic" prefix="Review of "/>
      </else-if>
      <else>
        <text variable="title" form="short" text-case="title" quotes="true"/>
      </else>
    </choose>
  </macro>
  <!-- "In Container-Title" for chapters/dictionary & encyclopedia entries (MDC 1.2.1.3, 1.2.1.4);
       abbreviated (short-form) journal/magazine/reference-work titles - MDC 1.2.6. -->
  <macro name="container-title">
    <choose>
      <if type="chapter paper-conference entry-dictionary entry-encyclopedia">
        <text term="in" text-case="capitalize-first" suffix=" "/>
        <choose>
          <if type="entry-dictionary entry-encyclopedia">
            <text variable="container-title" form="short" font-style="italic"/>
          </if>
          <else>
            <text variable="container-title" text-case="title" font-style="italic"/>
          </else>
        </choose>
      </if>
    </choose>
  </macro>
  <!-- ==========================================================================
       SPECIAL SOURCE TYPE DESCRIPTIONS
       ========================================================================== -->
  <!-- Bibliography "genre" line (e.g. "Unpublished lecture", "Class handout") and interviewer
       credit - MDC 1.2.1.7 Unpublished Lectures, 1.2.1.11 Handouts, 1.2.1.20 Interviews. -->
  <macro name="description">
    <choose>
      <if
        type="book chapter article-journal article-magazine article-newspaper entry-dictionary entry-encyclopedia"/>
      <else>
        <group delimiter=", ">
          <group delimiter=". ">
            <text macro="interviewer"/>
            <text variable="medium" text-case="capitalize-first"/>
          </group>
          <choose>
            <if variable="title" match="none"/>
            <else-if type="thesis speech webpage post-weblog"/>
            <else>
              <text variable="genre" text-case="capitalize-first"/>
            </else>
          </choose>
        </group>
      </else>
    </choose>
  </macro>
  <!-- ==========================================================================
       VOLUME/ISSUE, PLACE/PUBLISHER, DATE, AND PAGE LOCATORS
       ========================================================================== -->
  <!-- Date rendering, which varies by type - MDC 2.20 Dates; legal_case gets an authority
       prefix; most types render year-month. -->
  <macro name="date-of-issue">
    <choose>
      <if variable="issued">
        <choose>
          <if type="graphic report">
            <date date-parts="year" form="text" variable="issued"/>
          </if>
          <else-if type="legal_case">
            <text variable="authority" suffix=" "/>
            <date date-parts="year" form="text" variable="issued"/>
          </else-if>
          <else-if
            type="bill book chapter graphic legal_case legislation motion_picture report song thesis">
            <date variable="issued" delimiter="–">
              <date-part name="year"/>
              <date-part name="month"/>
            </date>
          </else-if>
          <else-if type="paper-conference">
            <date date-parts="year-month-day" form="text" variable="issued"/>
          </else-if>
          <else-if type="article-journal">
            <date date-parts="year" form="text" variable="issued"/>
          </else-if>
          <else>
            <date form="text" variable="issued"/>
          </else>
        </choose>
      </if>
      <else>
        <text term="no date"/>
      </else>
    </choose>
  </macro>
  <!-- "City: Publisher" - shared by the normal publication line and both halves of a
       reprint's publication history (original and current). -->
  <macro name="publisher-full">
    <group delimiter=": ">
      <text variable="publisher-place"/>
      <text variable="publisher"/>
    </group>
  </macro>
  <!-- In general, most details that locate a source are grouped together after the main title.
    For example, "(Year)" for journals/legal cases; "Genre, Institution, Year" for theses (MDC 1.2.1.6);
    "City: Publisher, Year" for most other types; date-only for newspapers (MDC 1.2.1.24). -->
  <macro name="locators">
    <choose>
      <if type="article-journal">
        <group delimiter=" ">
          <group font-style="italic">
            <text variable="container-title" text-case="title"/>
          </group>
          <group>
            <text variable="volume" strip-periods="false" prefix=" "/>
            <text variable="issue" strip-periods="false" prefix="."/>
          </group>
          <text macro="date-of-issue" prefix=" (" suffix=")"/>
          <choose>
            <if variable="page">
              <text variable="page"/>
            </if>
          </choose>
        </group>
      </if>
      <else-if type="thesis">
        <group delimiter=", ">
          <text variable="genre" text-case="capitalize-first"/>
          <text variable="publisher"/>
          <text macro="date-of-issue"/>
        </group>
      </else-if>
      <else-if type="article-newspaper">
        <group delimiter=", ">
          <group>
            <text variable="edition" suffix=" "/>
            <text term="edition" prefix=" "/>
          </group>
          <group>
            <text term="section" form="short" suffix=" "/>
            <text variable="section"/>
          </group>
        </group>
      </else-if>
      <else-if type="speech">
        <group delimiter=", ">
          <group>
            <text variable="genre" text-case="capitalize-first"/>
            <text term="presented at" prefix=" "/>
            <text variable="event" prefix=" "/>
          </group>
          <text variable="event-place"/>
          <text macro="date-of-issue"/>
        </group>
      </else-if>
      <else-if type="article-newspaper">
        <date form="text" variable="issued" prefix=", "/>
      </else-if>
      <else-if type="legal_case">
        <text variable="volume" prefix=", "/>
        <text variable="container-title" prefix=" "/>
        <text variable="page" prefix=" "/>
      </else-if>
      <else-if variable="publisher-place publisher" match="any">
        <choose>
          <if variable="original-date">
            <!-- Reprint - MDC 1.2.1.1.15 (see Jeremias/Denniston examples): "OriginalYear.
                 Reprint, City: Publisher, Year." Original publisher/place are shown only if the
                 item itself has them populated (CMOS 14.119: include them only where relevant). -->
            <group delimiter=". ">
              <group delimiter=", ">
                <choose>
                  <if variable="original-publisher original-publisher-place" match="any">
                    <group delimiter=": ">
                      <text variable="original-publisher-place"/>
                      <text variable="original-publisher"/>
                    </group>
                  </if>
                </choose>
                <date variable="original-date">
                  <date-part name="year"/>
                </date>
              </group>
              <group delimiter=", " prefix="Reprint, ">
                <text macro="publisher-full"/>
                <text macro="date-of-issue"/>
              </group>
            </group>
          </if>
          <else>
            <group delimiter=", ">
              <text macro="publisher-full"/>
              <text macro="date-of-issue"/>
            </group>
          </else>
        </choose>
      </else-if>
      <else>
        <text macro="date-of-issue"/>
      </else>
    </choose>
  </macro>
  <!-- For chapters in books, including conference presentataions, bibliography entries require "volume:page"
    at the end of the container info. - MDC 1.2.1.3.2. -->
  <macro name="container-locators">
    <choose>
      <if type="chapter paper-conference entry-dictionary entry-encyclopedia">
        <choose>
          <if variable="page">
            <text variable="volume" suffix=":"/>
            <text variable="page"/>
          </if>
        </choose>
      </if>
    </choose>
  </macro>
  <!-- Footnote locator (page, or volume:page for multi-volume works). This is the only
       locator-rendering macro used in <citation>; see the header note on "no ibid.". -->
  <macro name="locators-short">
    <group>
      <choose>
        <if locator="page" match="none">
          <choose>
            <if type="bill book graphic legal_case legislation motion_picture report song">
              <choose>
                <if variable="volume"/>
                <else>
                  <label variable="locator" form="short" suffix=" "/>
                </else>
              </choose>
            </if>
          </choose>
        </if>
        <else-if type="bill book graphic legal_case legislation motion_picture report song">
          <number variable="volume" form="numeric" suffix=":"/>
        </else-if>
      </choose>
      <text variable="locator"/>
    </group>
  </macro>
  <!-- ==========================================================================
       MULTI-VOLUMES, SERIES, AND EDITIONS
       ========================================================================== -->
  <macro name="multi-volume">
    <choose>
      <if type="bill book graphic legal_case legislation motion_picture report song">
        <group>
          <number variable="number-of-volumes" form="numeric"/>
          <text term="volume" form="short" prefix=" " plural="true"/>
        </group>
      </if>
    </choose>
  </macro>
  <!-- Series name + number - MDC 1.2.6 Abbreviating Book Series and Journal Titles. -->
  <macro name="series">
    <choose>
      <if type="article-journal" match="none">
        <group>
          <text variable="collection-title" text-case="title"/>
          <text variable="collection-number" prefix=" "/>
        </group>
      </if>
    </choose>
  </macro>
  <!-- MDC 1.2.1.1.14 Editions (e.g. "2nd ed.", ordinal + "ed." forms). -->
  <macro name="edition">
    <choose>
      <if type="article-journal entry-dictionary entry-encyclopedia legal_case" match="none">
        <choose>
          <if is-numeric="edition">
            <group delimiter=" ">
              <number variable="edition" form="ordinal"/>
              <text term="edition" form="short"/>
            </group>
          </if>
          <else>
            <text variable="edition" text-case="capitalize-first"/>
          </else>
        </choose>
      </if>
    </choose>
  </macro>
  <!-- ==========================================================================
       ARCHIVES
       ========================================================================== -->
  <!-- MDC 1.2.1.22 Archives (location, collection, place). -->
  <macro name="archive">
    <group delimiter=". ">
      <text variable="archive_location" text-case="capitalize-first"/>
      <text variable="archive"/>
      <text variable="archive-place"/>
    </group>
  </macro>
  <!-- ==========================================================================
       PAGINATION CHECK
       ========================================================================== -->
  <!-- "No pages" for subsections within online-only resources that lack print pagination - e.g. MDC 1.2.1.2.4 Online-Only Articles -->
  <macro name="pagination-check">
    <choose>
      <if type="article-journal entry-dictionary entry-encyclopedia webpage post-weblog">
        <choose>
          <if variable="page" match="none">
            <text value="No pages"/>
          </if>
        </choose>
      </if>
    </choose>
  </macro>
  <!-- ==========================================================================
       DOIS & URLS
       ========================================================================== -->
  <!-- DOI/URL handling at the end of a bibliography entry:
       - no DOI or URL for books, book chapters, theses, or presentations (requires manual fix for online-only resources of these types)
       - webpages/blogs get "Online: URL" (MDC 1.2.1.14)
       - online-only dictionary/encyclopedia entries (i.e. those with no typeset page range) get the same (MDC 1.2.1.5)
       - journal articles: DOI only if unpaginated (suggestion online-only); never DOI and URL together (MDC 1.2.1.2.3-4)
       - everything else (books, chapters, etc.): DOI if present, else a plain URL -->
  <macro name="electronic-access">
    <group>
      <text macro="archive"/>
      <choose>
        <!-- Webpages/blogs: MDC 1.2.1.14 requires "Online: URL" -->
        <if type="webpage post-weblog">
          <choose>
            <if variable="URL">
              <text variable="URL" prefix="Online: "/>
            </if>
          </choose>
        </if>
        <!-- Books, chapters in books, theses, presentations - never include DOI or URL;
          (requires manual fix for online-only books and book chapters; MDC never wants online info for theses) -->
        <else-if type="book chapter thesis speech"/>
        <!-- Journal articles (MDC 1.2.1.2.3-4) and dictionary/encyclopedia entries (MDC 1.2.1.5):
             no DOI or URL when paginated (requires manual fix for a paginated online-only
             periodical - see the "clarifying DOI/URL handling" discussion); otherwise DOI if
             present, else URL, never both. -->
        <else-if type="article-journal entry-dictionary entry-encyclopedia" match="any">
          <choose>
            <if variable="page"/>
            <else-if variable="DOI">
              <text variable="DOI" prefix="DOI: "/>
            </else-if>
            <else-if variable="URL">
              <text variable="URL" prefix="Online: "/>
            </else-if>
          </choose>
        </else-if>
        <!-- Fallback - for all remaining resources, include a DOI if possible, otherwise fall back to URL -->
        <else-if variable="DOI">
          <text variable="DOI" prefix="DOI: "/>
        </else-if>
        <else-if variable="URL">
          <text variable="URL" prefix="Online: "/>
        </else-if>
      </choose>
    </group>
  </macro>
  <!-- ==========================================================================
       ELECTRONIC FORMATS
       ========================================================================== -->
  <!-- Kindle editions: MDC 1.2.1.13 requires "Kindle edition." -->
  <macro name="electronic-format">
    <choose>
      <if type="book chapter entry-encyclopedia" variable="medium">
        <text text-case="capitalize-first" variable="medium"/>
      </if>
    </choose>
  </macro>
  <!-- ==========================================================================
       CITATION (FOOTNOTES)

       Always short-form: author short-name, short title, locator; see the header note.
       et-al-min/et-al-use-first here (not on bibliography) is what makes footnotes
       truncate to "et al." after 3+ authors while the bibliography lists everyone.
       ========================================================================== -->
  <citation et-al-min="3" et-al-use-first="1" disambiguate-add-names="true">
    <sort>
      <key macro="sort-contributors"/>
      <key variable="title"/>
      <key variable="genre"/>
      <key variable="issued"/>
    </sort>
    <layout delimiter="; " suffix=".">
      <group delimiter=", ">
        <text macro="contributors-short"/>
        <text macro="title-short"/>
        <text macro="locators-short"/>
      </group>
    </layout>
  </citation>
  <!-- ==========================================================================
       BIBLIOGRAPHY

       Hanging indent + 3-em-dash subsequent-author-substitute - MDC 1.2 Bibliography,
       1.2.3 Arranging Entries. Sorted by author/editor, then sole-before-multi-authored
       before sole-before-multi-edited (see sort-contributor-group/sort-full-names above),
       then title, genre, and date. This follows APA 7th's convention for the sole-vs-multi
       split (ties among co-authored/co-edited works broken by 2nd/3rd/... author).
       ========================================================================== -->
  <bibliography hanging-indent="true" subsequent-author-substitute="&#8212;&#8212;&#8212;"
    entry-spacing="1">
    <sort>
      <key macro="sort-contributors"/>
      <key macro="sort-contributor-group"/>
      <key macro="sort-full-names"/>
      <key variable="title"/>
      <key variable="genre"/>
      <key variable="issued"/>
    </sort>
    <layout>
      <group suffix=".">
        <group delimiter=". ">
          <text macro="contributors-full"/>
          <text macro="title"/>
          <text macro="description"/>
          <text macro="editor-secondary"/>
          <text macro="translator-secondary"/>
          <group delimiter=", ">
            <text macro="container-title"/>
            <text macro="container-contributors"/>
            <text macro="container-locators"/>
          </group>
          <text macro="edition"/>
          <text macro="multi-volume"/>
          <text macro="series"/>
          <text macro="locators"/>
          <text macro="pagination-check"/>
          <text macro="electronic-access"/>
          <text macro="electronic-format"/>
        </group>
      </group>
    </layout>
  </bibliography>
</style>
