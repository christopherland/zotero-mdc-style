<?xml version="1.0" encoding="utf-8"?>
<style class="note" version="1.0" and="text" initialize="false" initialize-with=". "
  page-range-format="minimal-two" demote-non-dropping-particle="sort-only" default-locale="en-US"
  xmlns="http://purl.org/net/xbiblio/csl">
  <!--
    McMaster Divinity College Press style.

    Implements the notes-and-bibliography citation system described in the
    McMaster Divinity College Press Style Guide (MDC), Version 1.2 (October 2025):
    https://mcmasterdivinity.ca/wp-content/uploads/2025/10/MDC-Press-Style-Guide-Version-1.2.pdf

    Section references in comments below (e.g. "MDC 1.2.1.2.4") point to numbered
    sections of that guide. Design notes worth knowing before editing:

    * Footnotes are always short-form (author short-name, short title, locator).
      MDC 1.1.2 explicitly forbids "ibid." and wants short titles even on a source's
      first appearance, so the citation layout has no position="first"/"ibid"
      branching. There is no separate "full first note" form to maintain.
    * Bibliography entries list every author/editor/translator; footnotes truncate
      to "et al." after 3+ names. This split (MDC's Version 1.2 update #4) is why
      several name macros come in two variants: a truncated one used only as a sort
      key, and an untruncated "full" one used for the actual bibliography text.
    * Macros are grouped below by function (Names, Titles, Container/Series,
      Locators and Dates, Publication Details, Archives/DOI/URL), independent of
      the order they're called in citation/bibliography. Every macro defined here
      is called from one or both of those; there is no dead/unused code.
    * Two MDC conventions are not implemented, because CSL's data model can't
      express them without a workaround on the Zotero-library side: 1) the
      abbreviated two-tier reference-work format for ABD/BDAG/TDNT-style sources
      (MDC 1.2.1.4), and 2) the four-tier bibliography ordering for an author's
      repeated entries: sole-authored, then multi-authored, then sole-edited,
      then multi-edited (MDC 1.2.3).
  -->
  <info>
    <title>McMaster Divinity College</title>
    <title-short>MDC</title-short>
    <id>https://www.zotero.org/styles/mcmaster-divinity-college</id>
    <link
      href="https://github.com/christopherland/zotero-mdc-style/blob/main/mcmaster-divinity-college.csl"
      rel="self"/>
    <link href="https://mcmasterdivinity.ca/mdcpress/#style-guide" rel="documentation"/>
    <author>
      <name>Dan Morrison</name>
      <email>morrid4@mcmaster.ca</email>
    </author>
    <author>
      <name>Christopher D. Land</name>
      <email>landc@mcmaster.ca</email>
    </author>
    <contributor>
      <name>Meghan D. Musy</name>
      <email>meghan.musy@gmail.com</email>
    </contributor>
    <contributor>
      <name>Alexander C. Stewart</name>
      <email>stewarac@mcmaster.ca</email>
    </contributor>
    <contributor>
      <name>Ryder Wishart</name>
      <email>wishartr@mcmaster.ca</email>
    </contributor>
    <contributor>
      <name>Ambrose Thomson</name>
      <email>ambrose.thomson@gmail.com</email>
    </contributor>
    <category citation-format="note"/>
    <category field="history"/>
    <summary>McMaster Divinity College style is used by students at MDC and authors publishing with
      MDC Press.</summary>
    <updated>2026-09-04T18:34:30+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a
      Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <!-- ==========================================================================
       NAMES: AUTHORS, EDITORS, TRANSLATORS, RECIPIENTS, INTERVIEWERS

       Building blocks first (editor/translator, in truncated, "-full", and
       "-note" short-form variants), then the composite "contributors-*"
       macros that assemble a full name list for one context each.
       ========================================================================== -->
  <!-- Truncated (et-al after 3) editor list. Feeds contributors-sort (used only as a sort key). -->
  <macro name="editor">
    <names variable="editor">
      <name and="text" delimiter-precedes-et-al="after-inverted-name"
        delimiter-precedes-last="always" et-al-min="3" et-al-use-first="1"
        name-as-sort-order="first"/>
      <label form="short" prefix=", "/>
    </names>
  </macro>
  <!-- Untruncated editor list - MDC update #4: bibliography lists every editor, no "et al." -->
  <macro name="editor-full">
    <names variable="editor">
      <name and="text" delimiter-precedes-et-al="after-inverted-name"
        delimiter-precedes-last="always" name-as-sort-order="first"/>
      <label form="short" prefix=", "/>
    </names>
  </macro>
  <!-- Short-form editor substitute for footnotes, incl. the ", ed." label - MDC 1.2.1.1.7. -->
  <macro name="editor-note">
    <names variable="editor">
      <name form="short" and="text"/>
      <label form="short" prefix=", "/>
    </names>
  </macro>
  <!-- Truncated translator list. Feeds contributors-sort (sort key only). -->
  <macro name="translator">
    <names variable="translator">
      <name and="text" delimiter-precedes-et-al="after-inverted-name"
        delimiter-precedes-last="always" et-al-min="3" et-al-use-first="1"
        name-as-sort-order="first"/>
      <label form="short" prefix=", "/>
    </names>
  </macro>
  <!-- Untruncated translator list for the bibliography - MDC update #4. -->
  <macro name="translator-full">
    <names variable="translator">
      <name and="text" delimiter-precedes-et-al="after-inverted-name"
        delimiter-precedes-last="always" name-as-sort-order="first"/>
      <label form="short" prefix=", "/>
    </names>
  </macro>
  <!-- Short-form translator substitute for footnotes. -->
  <macro name="translator-note">
    <names variable="translator">
      <name form="short" and="text"/>
      <label form="verb-short" prefix=", "/>
    </names>
  </macro>
  <!-- SORT KEY ONLY: author (or editor/translator if no author), truncated. Truncation here only
       affects the string used for alphabetizing, never what gets printed - see contributors-full/-short. -->
  <macro name="contributors-sort">
    <names variable="author">
      <name and="text" delimiter-precedes-et-al="after-inverted-name"
        delimiter-precedes-last="after-inverted-name" et-al-min="3" et-al-use-first="1"
        initialize="false" initialize-with=". " name-as-sort-order="first"/>
      <substitute>
        <text macro="editor"/>
        <text macro="translator"/>
      </substitute>
    </names>
  </macro>
  <!-- Bibliography author line: every author listed, substituting editor-full/translator-full
       when there is no author (e.g. edited volumes) - MDC update #4. -->
  <macro name="contributors-full">
    <names variable="author">
      <name and="text" delimiter-precedes-et-al="after-inverted-name"
        delimiter-precedes-last="always" initialize="false" initialize-with=". "
        name-as-sort-order="first"/>
      <substitute>
        <text macro="editor-full"/>
        <text macro="translator-full"/>
      </substitute>
    </names>
  </macro>
  <!-- Footnote author line: short-name + et-al after 3 (set on <citation>, MDC 1.1), substituting
       editor-note/translator-note, or recipient-short for personal_communication items. -->
  <macro name="contributors-short">
    <names variable="author">
      <name form="short" and="text" delimiter=", "/>
      <substitute>
        <text macro="editor-note"/>
        <text macro="translator-note"/>
      </substitute>
    </names>
    <text macro="recipient-short"/>
  </macro>
  <!-- Footnote "to Recipient" for personal_communication (letters, emails) - MDC 1.2.1.20. -->
  <macro name="recipient-short">
    <names variable="recipient">
      <label form="verb" prefix=" " suffix=" "/>
      <name form="short" and="text" delimiter=", "/>
    </names>
  </macro>
  <!-- Bibliography "Interview by X" credit line - MDC 1.2.1.20 Interviews. -->
  <macro name="interviewer">
    <names variable="interviewer" delimiter=", ">
      <label form="verb" prefix=" " text-case="capitalize-first" suffix=" "/>
      <name and="text" delimiter=", "/>
    </names>
  </macro>
  <!-- Bibliography "Edited by X. Translated by Y." line for a work's own editor/translator
       when an author is also present - MDC 1.2.1.1.4 Books with Editors, Translators, and/or Revisers. -->
  <macro name="secondary-contributors">
    <choose>
      <if type="paper-conference entry-dictionary chapter entry-encyclopedia" match="none">
        <group delimiter=". ">
          <choose>
            <if variable="author">
              <names variable="editor" delimiter=". " suffix=".">
                <label form="verb" text-case="capitalize-first" suffix=" "/>
                <name and="text" delimiter=", "/>
              </names>
            </if>
            <else-if match="any" variable="editor"/>
          </choose>
          <choose>
            <if variable="author editor" match="any">
              <names variable="translator" delimiter=". " suffix=".">
                <label form="verb" text-case="capitalize-first" suffix=" "/>
                <name delimiter="," and="text"/>
              </names>
            </if>
          </choose>
        </group>
      </if>
    </choose>
  </macro>
  <!-- The editor/translator credit for the CONTAINING work, when citing a chapter or an
       encyclopedia/dictionary entry - MDC 1.2.1.3 Book Chapters, 1.2.1.4 Encyclopedia Entries. -->
  <macro name="container-contributors">
    <choose>
      <if type="chapter paper-conference entry-encyclopedia entry-dictionary" match="any">
        <group delimiter=", ">
          <choose>
            <if variable="author">
              <names variable="container-author editor" delimiter=", ">
                <label form="verb" suffix=" "/>
                <name and="text" delimiter=", "/>
              </names>
            </if>
          </choose>
          <choose>
            <if variable="author editor" match="any">
              <names variable="translator" delimiter=", ">
                <label form="verb" suffix=" "/>
                <name and="text" delimiter=", "/>
              </names>
            </if>
          </choose>
        </group>
      </if>
    </choose>
  </macro>
  <!-- ==========================================================================
       TITLES
       ========================================================================== -->
  <!-- Bibliography title: italic for standalone works (books, films, etc.), quoted for
       articles/chapters, with the "Review of ..." handling for MDC 1.2.1.10 Book Reviews.
       Capitalization follows MDC 1.2.3.1 (headline-style title case). -->
  <macro name="title">
    <choose>
      <if variable="title" match="none">
        <choose>
          <if type="personal_communication" match="none">
            <text variable="genre"/>
          </if>
        </choose>
      </if>
      <else-if type="bill book graphic legal_case legislation motion_picture report" match="any">
        <text variable="title" text-case="title" font-style="italic" suffix="."/>
      </else-if>
      <else-if variable="reviewed-author">
        <group delimiter=", " suffix=".">
          <text variable="title" font-style="italic" prefix="Review of "/>
          <names variable="reviewed-author">
            <label form="verb-short" text-case="lowercase" suffix=" "/>
            <name and="text" delimiter=", "/>
          </names>
        </group>
      </else-if>
      <else>
        <text variable="title" text-case="title" quotes="true" suffix="."/>
      </else>
    </choose>
  </macro>
  <!-- Footnote short title - MDC 1.1.1 Short Titles. Relies on Zotero's "Short Title" field. -->
  <macro name="title-short">
    <choose>
      <if variable="title" match="none">
        <choose>
          <if type="interview">
            <text term="interview" text-case="lowercase"/>
          </if>
          <else-if type="manuscript speech" match="any">
            <text variable="genre" form="short"/>
          </else-if>
          <else-if type="personal_communication">
            <text macro="issued"/>
          </else-if>
        </choose>
      </if>
      <else-if type="bill book graphic legal_case legislation motion_picture report song"
        match="any">
        <text variable="title" form="short" text-case="title" font-style="italic"/>
      </else-if>
      <else-if variable="reviewed-author">
        <text variable="title-short" text-case="title" font-style="italic" prefix="Review of "/>
      </else-if>
      <else>
        <text variable="title" form="short" text-case="title" quotes="true"/>
      </else>
    </choose>
  </macro>
  <!-- ==========================================================================
       DESCRIPTION, CONTAINER TITLE & SERIES
       ========================================================================== -->
  <!-- Bibliography "genre" line (e.g. "Unpublished lecture", "Class handout") and interviewer
       credit - MDC 1.2.1.7 Unpublished Lectures, 1.2.1.11 Handouts, 1.2.1.20 Interviews. -->
  <macro name="description">
    <group delimiter=", ">
      <group delimiter=". ">
        <text macro="interviewer"/>
        <text variable="medium" text-case="capitalize-first"/>
      </group>
      <choose>
        <if variable="title" match="none"/>
        <else-if type="thesis speech webpage post-weblog" match="any"/>
        <else>
          <text variable="genre" text-case="capitalize-first"/>
        </else>
      </choose>
    </group>
  </macro>
  <!-- "In Container-Title" for chapters/dictionary & encyclopedia entries (MDC 1.2.1.3, 1.2.1.4);
       abbreviated (short-form) journal/magazine/reference-work titles - MDC 1.2.6. -->
  <macro name="container-title">
    <choose>
      <if type="chapter paper-conference entry-dictionary entry-encyclopedia" match="any">
        <text term="in" text-case="capitalize-first" suffix=" "/>
      </if>
    </choose>
    <choose>
      <if type="legal_case" match="none">
        <choose>
          <if type="article-journal article-magazine entry-dictionary entry-encyclopedia"
            match="any">
            <text variable="container-title" form="short" font-style="italic"/>
          </if>
          <else>
            <text variable="container-title" text-case="title" font-style="italic"/>
          </else>
        </choose>
      </if>
    </choose>
  </macro>
  <!-- Series name + number - MDC 1.2.6 Abbreviating Book Series and Journal Titles. -->
  <macro name="collection-title">
    <choose>
      <if type="article-journal" match="none">
        <group suffix=".">
          <text variable="collection-title" text-case="title"/>
          <text variable="collection-number" prefix=" "/>
        </group>
      </if>
    </choose>
  </macro>
  <!-- ==========================================================================
       EDITION & VOLUME/PAGE LOCATORS
       ========================================================================== -->
  <!-- MDC 1.2.1.1.14 Editions (e.g. "2nd ed.", ordinal + "ed." forms). -->
  <macro name="edition">
    <choose>
      <if
        type="bill book chapter graphic legal_case legislation motion_picture paper-conference report song"
        match="any">
        <choose>
          <if is-numeric="edition">
            <group delimiter=" ">
              <number variable="edition" form="ordinal"/>
              <text term="edition" form="short"/>
            </group>
          </if>
          <else>
            <text variable="edition" text-case="capitalize-first" suffix="."/>
          </else>
        </choose>
      </if>
    </choose>
  </macro>
  <!-- Bibliography volume/issue/page-range placement, which varies by type - MDC 1.2.1.2.2
       (journal volume.issue), 1.2.1.1.10-12 (multi-volume works), 1.2.1.3 (chapter volume). -->
  <macro name="locators">
    <choose>
      <if type="entry-dictionary entry-encyclopedia" match="any">
        <text variable="volume" strip-periods="false" prefix=", "/>
      </if>
      <else-if type="article-journal" match="any">
        <text variable="volume" strip-periods="false" prefix=" "/>
        <text variable="issue" strip-periods="false" prefix="."/>
      </else-if>
      <else-if type="legal_case">
        <text variable="volume" prefix=", "/>
        <text variable="container-title" prefix=" "/>
        <text variable="page" prefix=" "/>
      </else-if>
      <else-if type="bill book graphic legal_case legislation motion_picture report song"
        match="any">
        <group prefix=" " delimiter=". ">
          <group>
            <number variable="number-of-volumes" form="numeric"/>
            <text term="volume" form="short" prefix=" " plural="true"/>
          </group>
          <text macro="edition"/>
        </group>
      </else-if>
      <else-if type="chapter paper-conference" match="any">
        <group prefix=". " delimiter=". ">
          <choose>
            <if variable="page" match="none">
              <group>
                <text term="volume" form="short" text-case="capitalize-first" suffix=" "/>
                <number variable="volume" form="numeric"/>
              </group>
            </if>
          </choose>
          <text macro="edition"/>
        </group>
      </else-if>
    </choose>
  </macro>
  <!-- Bibliography edition/section info - MDC 1.2.1.24 Newspapers and News Sites. -->
  <macro name="locators-newspaper">
    <choose>
      <if type="article-newspaper">
        <group delimiter=", ">
          <group>
            <text variable="edition" suffix=" "/>
            <text term="edition" prefix=" "/>
          </group>
          <group>
            <text term="section" form="short" suffix=" "/>
            <text variable="section"/>
          </group>
        </group>
      </if>
    </choose>
  </macro>
  <!-- Bibliography "volume:page." for book chapters - MDC 1.2.1.3.2. -->
  <macro name="locators-chapter">
    <choose>
      <if type="chapter paper-conference" match="any">
        <choose>
          <if variable="page">
            <text variable="volume" suffix=":"/>
            <text variable="page" suffix="."/>
          </if>
        </choose>
      </if>
    </choose>
  </macro>
  <!-- Bibliography journal page range, or "No pages." for online-only articles without
       print pagination - MDC 1.2.1.2.4 Online-Only Articles. -->
  <macro name="locators-journal">
    <choose>
      <if type="article-journal" match="any">
        <choose>
          <if match="any" variable="page">
            <text variable="page" prefix=" "/>
          </if>
          <else>
            <text value="No pages" prefix=". "/>
          </else>
        </choose>
      </if>
    </choose>
  </macro>
  <!-- Bibliography "volume:page." for dictionary/encyclopedia entries - MDC 1.2.1.4. -->
  <macro name="locators-entry">
    <choose>
      <if type="entry-dictionary entry-encyclopedia" match="any">
        <choose>
          <if variable="volume" match="any">
            <text variable="page" prefix=":" suffix="."/>
          </if>
          <else>
            <text variable="page" prefix=", " suffix="."/>
          </else>
        </choose>
      </if>
    </choose>
  </macro>
  <!-- Footnote locator (page, or volume:page for multi-volume works). This is the only
       locator-rendering macro used in <citation>; see the header note on "no ibid.". -->
  <macro name="point-locators-subsequent">
    <group>
      <choose>
        <if locator="page" match="none">
          <choose>
            <if type="bill book graphic legal_case legislation motion_picture report song"
              match="any">
              <choose>
                <if variable="volume"/>
                <else>
                  <label variable="locator" form="short" suffix=" "/>
                </else>
              </choose>
            </if>
          </choose>
        </if>
        <else-if type="bill book graphic legal_case legislation motion_picture report song"
          match="any">
          <number variable="volume" form="numeric" suffix=":"/>
        </else-if>
      </choose>
      <text variable="locator"/>
    </group>
  </macro>
  <!-- ==========================================================================
       EVENTS, PUBLISHER & DATES
       ========================================================================== -->
  <!-- "presented at CONFERENCE" - MDC 1.2.1.8 Conference Presentations. -->
  <macro name="event">
    <group>
      <text term="presented at" suffix=" "/>
      <text variable="event"/>
    </group>
  </macro>
  <!-- "City: Publisher" - MDC 1.2.7 Cities and Publishers (correct forms for common presses). -->
  <macro name="publisher">
    <group delimiter=": ">
      <text variable="publisher-place"/>
      <text variable="publisher"/>
    </group>
  </macro>
  <!-- Date rendering, which varies by type - MDC 2.20 Dates; legal_case gets an authority
       prefix; most types render year-month. -->
  <macro name="issued">
    <choose>
      <if variable="issued">
        <choose>
          <if type="graphic report" match="any">
            <date date-parts="year" form="text" variable="issued"/>
          </if>
          <else-if type="legal_case">
            <text variable="authority" suffix=" "/>
            <date date-parts="year" form="text" variable="issued"/>
          </else-if>
          <else-if
            type="bill book chapter graphic legal_case legislation motion_picture report song thesis"
            match="any">
            <date variable="issued" delimiter="–">
              <date-part name="year"/>
              <date-part name="month"/>
            </date>
          </else-if>
          <else-if type="paper-conference" match="any">
            <date date-parts="year-month-day" form="text" variable="issued"/>
          </else-if>
          <else-if type="article-journal" match="any">
            <choose>
              <if match="any" variable="DOI URL">
                <date date-parts="year" form="text" variable="issued"/>
              </if>
              <else>
                <date date-parts="year" form="text" variable="issued"/>
              </else>
            </choose>
          </else-if>
          <else>
            <date form="text" variable="issued"/>
          </else>
        </choose>
      </if>
      <else>
        <text term="no date"/>
      </else>
    </choose>
  </macro>
  <!-- The publication-details group after the title: "(Year)" for journals/legal cases;
       "Genre, Institution, Year" for theses (MDC 1.2.1.6); "(City: Publisher, Year)" for
       most other types; date-only for newspapers (MDC 1.2.1.24). -->
  <macro name="issue">
    <choose>
      <if type="article-journal legal_case" match="any">
        <text macro="issued" prefix=" (" suffix=")"/>
      </if>
      <else-if type="speech">
        <choose>
          <if variable="title" match="none"/>
          <else>
            <text variable="genre" text-case="capitalize-first" prefix=". "/>
          </else>
        </choose>
        <text macro="event" prefix=" "/>
        <text variable="event-place" prefix=", "/>
        <text macro="issued" prefix=", "/>
      </else-if>
      <else-if variable="publisher-place publisher" match="any">
        <group delimiter=", " prefix=" ">
          <choose>
            <if type="thesis">
              <text variable="genre" text-case="capitalize-first"/>
              <text variable="publisher"/>
              <text macro="issued"/>
            </if>
          </choose>
          <choose>
            <if type="thesis" match="none">
              <text macro="publisher"/>
              <text macro="issued"/>
            </if>
          </choose>
        </group>
      </else-if>
      <else-if type="article-newspaper" match="any">
        <date form="text" variable="issued" prefix=", "/>
      </else-if>
      <else-if type="thesis" match="any">
        <text variable="genre"/>
      </else-if>
      <else>
        <text macro="issued" prefix=", "/>
      </else>
    </choose>
  </macro>
  <!-- ==========================================================================
       ARCHIVES, DOIS & URLS
       ========================================================================== -->
  <!-- MDC 1.2.1.22 Archives (location, collection, place). -->
  <macro name="archive">
    <group delimiter=". ">
      <text variable="archive_location" text-case="capitalize-first"/>
      <text variable="archive"/>
      <text variable="archive-place"/>
    </group>
  </macro>
  <!-- DOI/URL handling at the end of a bibliography entry:
       - webpages/blogs get "No pages. Online: URL" (MDC 1.2.1.14)
       - online-only dictionary/encyclopedia entries with no print page get the same
         (MDC 1.2.1.5); entries that do have a page just get a plain URL
       - journal articles: DOI only if present, never DOI and URL together (MDC 1.2.1.2.3-4)
       - everything else (books, chapters, etc.): DOI if present, else a plain URL -->
  <macro name="access">
    <group>
      <choose>
        <if type="graphic report" match="any">
          <text macro="archive"/>
        </if>
        <else-if
          type="article-journal article-magazine article-newspaper bill book chapter graphic legal_case legislation motion_picture paper-conference report song thesis entry-encyclopedia entry-dictionary"
          match="none">
          <text macro="archive"/>
        </else-if>
      </choose>
      <choose>
        <if type="legal_case" match="none">
          <choose>
            <!-- Webpages/blogs: MDC 1.2.1.14 requires "No pages. Online: URL" -->
            <if type="webpage post-weblog" match="any">
              <choose>
                <if variable="URL">
                  <text value="No pages. Online: " prefix=". "/>
                  <text variable="URL"/>
                </if>
              </choose>
            </if>
            <!-- Dictionary/encyclopedia entries with no print page (online-only): MDC 1.2.1.5 -->
            <else-if type="entry-dictionary entry-encyclopedia" match="any">
              <choose>
                <if variable="page" match="none">
                  <choose>
                    <if variable="URL">
                      <text value="No pages. Online: " prefix=". "/>
                      <text variable="URL"/>
                    </if>
                  </choose>
                </if>
                <else-if variable="URL">
                  <text variable="URL" prefix=". "/>
                </else-if>
              </choose>
            </else-if>
            <!-- Journal articles: MDC 1.2.1.2.3-4 - if a DOI exists, cite the DOI only, never both DOI and URL -->
            <else-if type="article-journal">
              <choose>
                <if variable="DOI">
                  <text variable="DOI" prefix=". DOI: "/>
                </if>
                <else-if variable="URL">
                  <text variable="URL" prefix=". Online: "/>
                </else-if>
              </choose>
            </else-if>
            <else-if type="book chapter" match="any">
              <choose>
                <if variable="DOI">
                  <text variable="DOI" prefix=". DOI: "/>
                </if>
                <else-if variable="URL">
                  <text variable="URL" prefix=". "/>
                </else-if>
              </choose>
            </else-if>
            <else>
              <choose>
                <if variable="DOI">
                  <text variable="DOI" prefix=". DOI: "/>
                </if>
                <else-if variable="URL">
                  <text variable="URL" prefix=", "/>
                </else-if>
              </choose>
            </else>
          </choose>
        </if>
        <else>
          <text variable="URL" prefix=", "/>
        </else>
      </choose>
    </group>
  </macro>
  <!-- ==========================================================================
       CITATION (FOOTNOTES)

       Always short-form: author short-name, short title, locator; see the header note.
       et-al-min/et-al-use-first here (not on bibliography) is what makes footnotes
       truncate to "et al." after 3+ authors while the bibliography lists everyone.
       ========================================================================== -->
  <citation et-al-min="3" et-al-use-first="1" disambiguate-add-names="true">
    <sort>
      <key macro="contributors-sort"/>
      <key variable="title"/>
      <key variable="genre"/>
      <key variable="issued"/>
    </sort>
    <layout delimiter="; " suffix=".">
      <group delimiter=", ">
        <text macro="contributors-short"/>
        <text macro="title-short"/>
        <text macro="point-locators-subsequent"/>
      </group>
    </layout>
  </citation>
  <!-- ==========================================================================
       BIBLIOGRAPHY

       Hanging indent + 3-em-dash subsequent-author-substitute - MDC 1.2 Bibliography,
       1.2.3 Arranging Entries. Sorted by author/editor, then title, genre, and date.
       This does not implement MDC 1.2.3's full four-tier sole/multi-author(ed/edited)
       ordering; see the header note.
       ========================================================================== -->
  <bibliography hanging-indent="true" subsequent-author-substitute="&#8212;&#8212;&#8212;"
    entry-spacing="1">
    <sort>
      <key macro="contributors-sort"/>
      <key variable="title"/>
      <key variable="genre"/>
      <key variable="issued"/>
    </sort>
    <layout>
      <group suffix=".">
        <group delimiter=" ">
          <text macro="contributors-full" suffix=". "/>
          <text macro="title"/>
          <text macro="description"/>
          <text macro="secondary-contributors" strip-periods="false" suffix=". "/>
          <group delimiter=", ">
            <text macro="container-title"/>
            <text macro="container-contributors"/>
            <text macro="locators-chapter"/>
          </group>
        </group>
        <text macro="locators"/>
        <text macro="locators-entry"/>
        <text macro="collection-title" prefix=" "/>
        <text macro="issue"/>
        <text macro="locators-newspaper" prefix=", "/>
        <text macro="locators-journal"/>
        <text macro="access"/>
      </group>
    </layout>
  </bibliography>
</style>
